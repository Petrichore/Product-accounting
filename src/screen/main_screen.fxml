<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0"
            prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.mainView.MainViewController">
    <children>
        <TableView fx:id="productTable" layoutX="50.0" layoutY="45.0" prefHeight="321.0" prefWidth="503.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="85.0" text="Номер"/>
                <TableColumn fx:id="nameColumn" prefWidth="147.0" text="Название"/>
                <TableColumn fx:id="priceColumn" prefWidth="123.0" text="Цена"/>
                <TableColumn fx:id="receiptDateColumn" prefWidth="147.0" text="Дата поступления"/>
            </columns>
        </TableView>
        <Button fx:id="editProduct" layoutX="413.0" layoutY="404.0" mnemonicParsing="false" prefHeight="35.0"
                prefWidth="117.0" style="-fx-background-color: #00CED1; -fx-background-radius: 10;" text="Изменить"
                textAlignment="CENTER" textFill="WHITE" wrapText="true">
            <font>
                <Font name="Book Antiqua Bold Italic" size="18.0"/>
            </font>
        </Button>
        <Button fx:id="deleteProduct" layoutX="243.0" layoutY="404.0" mnemonicParsing="false" prefHeight="35.0"
                prefWidth="117.0" style="-fx-background-color: #00CED1; -fx-background-radius: 10;" text="Удалить"
                textAlignment="CENTER" textFill="WHITE" wrapText="true">
            <font>
                <Font name="Book Antiqua Bold Italic" size="18.0"/>
            </font>
        </Button>
        <Button fx:id="addProduct" layoutX="71.0" layoutY="404.0" mnemonicParsing="false" prefHeight="35.0"
                prefWidth="117.0" style="-fx-background-color: #00CED1; -fx-background-radius: 10;" text="Добавить"
                textAlignment="CENTER" textFill="WHITE" wrapText="true">
            <font>
                <Font name="Book Antiqua Bold Italic" size="18.0"/>
            </font>
        </Button>
        <Label layoutX="599.0" layoutY="82.0" text="Выбрать категорию:">
            <font>
                <Font size="17.0"/>
            </font>
        </Label>
        <ComboBox fx:id="selectCategoryComboBox" layoutX="603.0" layoutY="122.0" prefWidth="150.0"/>
        <Label layoutX="614.0" layoutY="206.0" text="Сортировать по:">
            <font>
                <Font size="17.0"/>
            </font>
        </Label>
        <VBox layoutX="614.0" layoutY="249.0" prefHeight="117.0" prefWidth="158.0" spacing="20.0">
            <children>
                <RadioButton fx:id="nameSortRadioBtn" mnemonicParsing="false" text="Название">
                    <font>
                        <Font size="14.0"/>
                    </font>
                    <toggleGroup>
                        <ToggleGroup fx:id="sortRadioBtnGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="priceSortRadioBtn" mnemonicParsing="false" text="Цена"
                             toggleGroup="$sortRadioBtnGroup">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </RadioButton>
                <RadioButton fx:id="receiptDateSortRadioBtn" mnemonicParsing="false" text="Дата поступления"
                             toggleGroup="$sortRadioBtnGroup">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </RadioButton>
            </children>
        </VBox>
    </children>
</AnchorPane>
